<view class="wrap">
  <view class="card" wx:if="{{current}}">
    <view class="title">{{current.name}}</view>
    <view class="tags">
      <text class="tag" wx:for="{{durations}}" wx:key="*this"
        data-value="{{item}}" bindtap="chooseDuration"
        style="{{duration === item ? 'background:#185FA5;color:#fff' : ''}}">
        {{item === '30s' ? '30 秒' : (item === '2m' ? '2 分钟' : '5 分钟')}}
      </text>
    </view>
    <view class="subtitle" wx:if="{{subtitle}}">{{subtitle}}</view>
    <view class="note" wx:if="{{!subtitle}}">{{loading ? '加载讲稿…' : '点击下方按钮开始讲解'}}</view>
    <view class="btn" bindtap="ask">听不懂？追问一句</view>
  </view>

  <view class="card">
    <view class="title">模拟触发（我已到达此处）</view>
    <view class="note">现场演示用这个，完全不依赖定位信号</view>
    <view class="list-item" wx:for="{{pois}}" wx:key="poiId" bindtap="play" data-poi="{{item.poiId}}">
      <view class="name">{{item.name}}</view>
      <view class="sub">{{item.stayMinutes}} 分钟 · 体力强度 {{item.intensity}}</view>
      <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
    </view>
  </view>
</view>
