/* 全局样式：页面级 wxss 只写差异部分 */
page {
  background: #f7f7f5;
  font-family: -apple-system, "PingFang SC", sans-serif;
  color: #2c2c2a;
  font-size: 28rpx;
  line-height: 1.6;
}

.wrap {
  padding: 32rpx 28rpx 64rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.sub {
  font-size: 24rpx;
  color: #888780;
}

.note {
  font-size: 22rpx;
  color: #888780;
  margin-top: 12rpx;
}

.btn {
  background: #185fa5;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  margin-top: 20rpx;
}

.btn.ghost {
  background: #ffffff;
  color: #185fa5;
  border: 1rpx solid #185fa5;
}

.btn[disabled] {
  background: #b4b2a9;
  color: #ffffff;
}

.input {
  background: #ffffff;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 16rpx;
  padding: 24rpx;
  width: auto;
  min-height: 120rpx;
}

.output {
  white-space: pre-wrap;
  word-break: break-all;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  color: #0f6e56;
  background: #e1f5ee;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin: 0 12rpx 12rpx 0;
}

.tag.warn {
  color: #854f0b;
  background: #faeeda;
}

.map {
  width: 100%;
  height: 420rpx;
  border-radius: 20rpx;
}

.slot {
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  padding: 20rpx 0;
}

.slot .time {
  font-size: 24rpx;
  color: #185fa5;
  margin-right: 16rpx;
}

.slot .name {
  font-size: 30rpx;
  font-weight: 500;
}

.slot .reason {
  display: block;
  font-size: 24rpx;
  color: #888780;
  margin-top: 6rpx;
}

.tags {
  margin-bottom: 12rpx;
}

.list-item {
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  padding: 24rpx 0;
}

.list-item .name {
  font-size: 30rpx;
  font-weight: 500;
}

.source {
  background: #eef1f7;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 24rpx;
  color: #3c3489;
  margin-top: 12rpx;
}

.subtitle {
  font-size: 30rpx;
  line-height: 1.8;
}

